# Single-tenant credentials (stdio, and HTTP only when AUTH_MODE=env).
# The gateway-mode compose service does not load these. Do not add them to
# that service's environment or via env_file.
DATTO_BCDR_PUBLIC_KEY=
DATTO_BCDR_PRIVATE_KEY=
# Region is not a credential. Optional: us (default) or eu.
# DATTO_BCDR_REGION=us

# stdio (default) or http
MCP_TRANSPORT=stdio

# Bind address. When MCP_HTTP_HOST is unset, the HTTP server binds 127.0.0.1.
# The container image sets 0.0.0.0 and requires CONDUIT_S2S_SECRET.
# MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8080

# Required to start the HTTP transport. Leave this empty here.
# Generate a value with: openssl rand -hex 32
# The process exits if this is empty or a known placeholder (so a copied
# example cannot forge X-Gateway-S2S). docker compose will not start if it
# is unset or empty. Never commit a real secret. The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without CONDUIT_S2S_SECRET.
# The server logs a warning, does not check X-Gateway-S2S, and binds 127.0.0.1 only.
# A non-loopback MCP_HTTP_HOST (including 0.0.0.0) is refused.
# MCP_ALLOW_INSECURE_DEV=1

# Credential source for HTTP: env (process environment) or gateway (required
# X-Datto-BCDR-Public-Key and X-Datto-BCDR-Private-Key headers; no env fallback).
# The container image and Compose set gateway. Stdio ignores this and reads
# DATTO_BCDR_* from the environment.
# AUTH_MODE=gateway
